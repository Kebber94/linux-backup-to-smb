#!/usr/bin/env bash

# The host name. It is included in the backup filename.
HOST_NAME="example-host"

# The directory where local backup archives are created and await transfer.
BACKUP_DIR="/path/to/local-backups"

# Directories to back up.
# Directories that do not exist are skipped with a warning.
# Do not include child directories separately if their parent is already included.
SOURCE_DIRS=(
    "/path/to/source-directory"
#    "/path/to/another-source"
)

# The SMB share to which local backup archives are transferred.
REMOTE_SHARE="//smb-server/share"

# The local mount point used for the SMB share.
MOUNT_POINT="/path/to/mount-point"

# The file containing the username and password for the SMB share.
CREDENTIALS_FILE="/path/to/smb-credentials"

# The number of remote backup archives to retain.
RETENTION_COUNT=4

# The directory where backup and transfer log files are stored.
LOG_DIR="${SCRIPT_DIR}/logs"

# The directory where Homarr-compatible status data is stored.
DATA_DIR="${SCRIPT_DIR}/data"

# The lock file that prevents concurrent local backup jobs.
BACKUP_LOCK_FILE="/run/lock/backup-create.lock"

# The lock file that prevents concurrent transfer jobs.
TRANSFER_LOCK_FILE="/run/lock/backup-transfer.lock"

# Mount options for the SMB share, including the credentials file and permissions.
MOUNT_OPTIONS="credentials=${CREDENTIALS_FILE},vers=3.0,iocharset=utf8,uid=0,gid=0,file_mode=0600,dir_mode=0700"
